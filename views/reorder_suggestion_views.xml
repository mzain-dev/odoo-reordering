    <!-- ── Bulk Snooze Server Actions (T-33) ──
         Appear in the list view's Action (⚙) menu when one or more rows are
         checkbox-selected — lets a buyer clear a batch of noise (e.g. right
         after a shipment lands and several SKUs are known to be covered) in
         one click instead of opening each suggestion individually. -->
    <record id="action_server_bulk_snooze_7" model="ir.actions.server">
        <field name="name">💤 Snooze Selected (7 days)</field>
        <field name="model_id" ref="model_smart_reorder_suggestion"/>
        <field name="binding_model_id" ref="model_smart_reorder_suggestion"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_bulk_snooze_7()</field>
    </record>

