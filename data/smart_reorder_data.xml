<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
        ╔═══════════════════════════════════════════════════════════════════╗
        ║  SCHEDULED ACTION — Reorder Analysis                              ║
        ║                                                                   ║
        ║  Initial schedule: every Monday at 6:00 AM (interval_number=1,    ║
        ║  interval_type='weeks'). Recalculates all suggestions for all     ║
        ║  companies/warehouses. Sends Odoo inbox notifications if          ║
        ║  critical items are found.                                       ║
        ║                                                                   ║
        ║  T-32: interval_number/interval_type are kept in sync with each   ║
        ║  smart.reorder.config's "Analysis Frequency" field (weekly /      ║
        ║  bi-weekly / monthly) by SmartReorderConfig._sync_cron_frequency  ║
        ║  whenever that field is saved — a manager changes the schedule    ║
        ║  from Configuration → Company Settings, not Scheduled Actions.    ║
        ║                                                                   ║
        ║  noupdate="1" means admins (or that sync logic) can change the   ║
        ║  schedule without it being reset on module update.                ║
        ╚═══════════════════════════════════════════════════════════════════╝
        -->

        <record id="cron_smart_reorder_weekly" model="ir.cron">
            <field name="name">Smart Reorder: Weekly Analysis</field>
            <field name="model_id" ref="model_smart_reorder_suggestion"/>
            <field name="state">code</field>
            <field name="code">model.action_run_weekly_cron()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <!-- Task 4: enabled by default — automated weekly delivery is
                 explicitly requested. Confirm the analysis window / lead time
                 / safety buffer defaults (Task 6) before this first runs for
                 real. noupdate="1" above means this change only reaches an
                 ALREADY-installed database via the migration script
                 (migrations/17.0.5.3.0/post-migrate.py), not automatically on
                 module update. -->
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="cron_smart_reorder_score_snapshots" model="ir.cron">
            <field name="name">Smart Reorder: Score Forecast Snapshots</field>
            <field name="model_id" ref="model_smart_reorder_forecast_snapshot"/>
            <field name="state">code</field>
            <field name="code">model._score_snapshots()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <!-- Enable manually after the analysis cron has been running long
                 enough to have snapshots older than one lead time to score. -->
            <field name="active">False</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!--
        Recommendation: missed-run detection. A lightweight daily heartbeat —
        NOT a re-run of the analysis itself — that only checks whether the
        weekly analysis cron has completed successfully within its expected
        window, and notifies notify_user_ids once if not. Enabled by default
        since it costs a handful of cheap queries per company per day and is
        the whole point of "don't let a stuck scheduler go unnoticed."
        -->
        <record id="cron_smart_reorder_overdue_check" model="ir.cron">
            <field name="name">Smart Reorder: Overdue Run Check</field>
            <field name="model_id" ref="model_smart_reorder_config"/>
            <field name="state">code</field>
            <field name="code">model._check_overdue_runs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
