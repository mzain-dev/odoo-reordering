<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_smart_reorder_suggestion_list" model="ir.ui.view">
        <field name="name">smart.reorder.suggestion.tree</field>
        <field name="model">smart.reorder.suggestion</field>
        <field name="arch" type="xml">
            <tree string="Reorder Suggestions"
                  banner_route="/smart_reorder_advisor/last_run_banner"
                  create="false" edit="false" delete="false"
                  decoration-danger="urgency == 'critical'"
                  decoration-warning="urgency == 'urgent'"
                  decoration-info="urgency == 'normal'"
                  decoration-muted="urgency in ('ok','dead') or is_stale">

                <header>
                    <button name="%(action_export_suggestions_wizard)d"
                            string="📊 Export to Excel"
                            type="action"
                            class="btn-secondary"/>
                </header>

                <field name="budget_rank"      string="#" optional="show"/>
                <field name="is_stale"         string="🕓 Stale?" optional="show"/>
                <field name="needs_review"     string="🔎 Review?" optional="show"/>
                <field name="urgency"          widget="badge"
                       decoration-danger="urgency == 'critical'"
                       decoration-warning="urgency == 'urgent'"
                       decoration-info="urgency == 'normal'"
                       decoration-success="urgency == 'ok'"
                       decoration-muted="urgency == 'dead'"/>
                <field name="abc_class"        widget="badge"
                       decoration-danger="abc_class == 'A'"
                       decoration-warning="abc_class == 'B'"
                       decoration-muted="abc_class == 'C'"/>
                <field name="demand_trend"     widget="badge"
                       decoration-success="demand_trend == 'up'"
                       decoration-danger="demand_trend == 'down'"
                       decoration-muted="demand_trend in ('stable','new')"
                       optional="show"/>
                <field name="sales_pattern"    widget="badge"
                       decoration-success="sales_pattern == 'regular'"
                       decoration-info="sales_pattern == 'sometimes'"
                       decoration-warning="sales_pattern == 'big_order_mixed'"
                       decoration-danger="sales_pattern == 'one_time_big_order'"
                       decoration-muted="sales_pattern == 'new'"
                       optional="show"/>

                <field name="company_id"       groups="base.group_multi_company" optional="show"/>
                <field name="warehouse_id"     optional="show"/>
                <field name="analysis_date"    string="Analysis Date" optional="show"/>
                <field name="default_code"     string="Part No."/>
                <field name="product_id"/>
                <field name="superseded_by_id" optional="hide"/>
                <field name="product_categ_id" optional="hide"/>

                <field name="qty_on_hand"      string="On Hand"
                       decoration-danger="qty_on_hand &lt; 0"/>
                <field name="qty_incoming"     string="PO Incoming" optional="show"/>
                <field name="qty_outgoing"     string="Outgoing" optional="show"/>
                <field name="qty_available"    string="Net Avail."/>
                <field name="months_of_stock"  string="Months Left" digits="[16,1]"
                       decoration-danger="months_of_stock &lt; 1"
                       decoration-warning="months_of_stock &lt; 2"/>
                <field name="months_of_stock_after_order" string="Months Left After Order" digits="[16,1]" optional="show"
                       decoration-danger="is_overstocked == True"/>
                <field name="is_overstocked" column_invisible="True"/>

                <field name="avg_monthly_demand" string="Avg/Month" digits="[16,2]"/>
                <field name="lead_time_months"   string="Lead (Mo)" digits="[16,1]" optional="show"/>
                <field name="moq"                string="MOQ" optional="show"/>
                <field name="min_stock_level"    string="Min Level" optional="show"/>
                <field name="max_stock_level"    string="Max Level" optional="show"/>

                <field name="raw_reorder_qty"        string="Raw Qty" optional="hide"/>
                <field name="suggested_reorder_qty"  string="Suggest Reorder"
                       decoration-bf="reorder_needed == True"/>
                <field name="prior_suggested_qty"    string="Prior Qty" optional="hide"/>
                <field name="delta_pct"              string="Δ% vs Last Run" optional="hide"
                       decoration-danger="delta_pct &gt; 50"
                       decoration-info="delta_pct &lt; 0"/>
                <field name="confidence"             string="Confidence" optional="hide" widget="progressbar"/>

                <field name="product_cost"     string="Unit Cost" optional="show"/>
                <field name="reorder_value"    string="Reorder Value (OMR)"
                       widget="monetary" options="{'currency_field': 'currency_id'}"
                       decoration-bf="reorder_needed == True"/>

                <field name="is_dead_stock"         string="Dead?" optional="show"/>
                <field name="months_since_last_sale" string="Mo. No Sale" optional="show"/>

                <field name="within_budget"    string="In Budget?" optional="show"/>
                <field name="is_provisional"   string="Provisional" optional="show" widget="boolean"/>

                <field name="vendor_id"        string="Vendor" optional="hide"/>

                <field name="transfer_source_warehouse_id" string="Transfer Source" optional="show"/>
                <field name="transfer_suggested_qty" string="Transfer Qty" optional="show"/>
                <field name="transfer_lead_time_days" string="Transfer Lead (Days)" optional="hide"/>

                <field name="draft_po_ref" string="Draft PO" optional="show"
                       decoration-warning="draft_po_ref"/>

                <field name="stale_reason"     string="Stale Reason" optional="hide"/>
                <field name="needs_review_reason" string="Review Reason" optional="hide"/>

                <field name="reorder_needed"   invisible="1"/>
                <field name="urgency_rank"     invisible="1"/>
                <field name="currency_id"      invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_smart_reorder_suggestion_form" model="ir.ui.view">
        <field name="name">smart.reorder.suggestion.form</field>
        <field name="model">smart.reorder.suggestion</field>
        <field name="arch" type="xml">
            <form string="Reorder Suggestion" create="false" edit="false">
                <header>
                    <button name="action_snooze_7"
                            string="💤 Snooze 7d"
                            type="object"
                            class="btn-secondary"
                            invisible="is_snoozed or not reorder_needed"/>
                    <button name="action_snooze_30"
                            string="💤 Snooze 30d"
                            type="object"
                            class="btn-secondary"
                            invisible="is_snoozed or not reorder_needed"/>
                    <button name="action_unsnooze"
                            string="⏰ Unsnooze"
                            type="object"
                            class="btn-warning"
                            invisible="not is_snoozed"/>
                    <button name="action_create_draft_po"
                            string="📋 Create Draft PO"
                            type="object"
                            class="btn-primary"
                            invisible="not reorder_needed"/>
                    <button name="action_create_internal_transfer"
                            string="🔄 Create Internal Transfer"
                            type="object"
                            class="btn-primary"
                            invisible="not transfer_source_warehouse_id"/>
                    <button name="action_refresh_vendor_performance"
                            string="🚚 Refresh Vendor Data"
                            type="object"
                            class="btn-secondary"
                            invisible="not vendor_id"/>
                    <button name="action_open_product"
                            string="🔍 View Product"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_open_stock_moves"
                            string="📦 Stock Moves"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_mark_one_time_order"
                            string="❌ This Was a One-Time Order"
                            type="object"
                            class="btn-warning"
                            invisible="not needs_review"
                            groups="smart_reorder_advisor.group_smart_reorder_manager"/>
                    <button name="action_mark_regular_order"
                            string="🔄 Customer Orders This Regularly"
                            type="object"
                            class="btn-primary"
                            invisible="not needs_review"
                            groups="smart_reorder_advisor.group_smart_reorder_manager"/>
                </header>

                <sheet>
                    <field name="is_stale" invisible="1"/>
                    <field name="needs_review" invisible="1"/>
                    <field name="is_provisional" invisible="1"/>
                    <div class="oe_title">
                        <div class="o_row" style="gap:8px; flex-wrap:wrap;">
                            <field name="urgency" widget="badge"
                                   decoration-danger="urgency == 'critical'"
                                   decoration-warning="urgency == 'urgent'"
                                   decoration-info="urgency == 'normal'"
                                   decoration-success="urgency == 'ok'"/>
                            <field name="abc_class" widget="badge"
                                   decoration-danger="abc_class == 'A'"
                                   decoration-warning="abc_class == 'B'"
                                   decoration-muted="abc_class == 'C'"/>
                            <field name="demand_trend" widget="badge"
                                   decoration-success="demand_trend == 'up'"
                                   decoration-danger="demand_trend == 'down'"
                                   decoration-muted="demand_trend in ('stable','new')"/>
                            <field name="sales_pattern" widget="badge"
                                   decoration-success="sales_pattern == 'regular'"
                                   decoration-info="sales_pattern == 'sometimes'"
                                   decoration-warning="sales_pattern == 'big_order_mixed'"
                                   decoration-danger="sales_pattern == 'one_time_big_order'"
                                   decoration-muted="sales_pattern == 'new'"/>
                        </div>
                        <h1><field name="product_id" readonly="1"/></h1>
                        <h3>
                            <field name="default_code" readonly="1"/> |
                            <field name="warehouse_id" readonly="1"/> |
                            <field name="company_id" readonly="1"
                                   groups="base.group_multi_company"/>
                        </h3>
                    </div>

                    <div class="alert alert-info" role="alert"
                         invisible="not is_snoozed">
                        ⏰ <strong>SNOOZED</strong> until <field name="snoozed_until" readonly="1"/>.
                        This item will not show as needing reorder until the snooze expires.
                        <span invisible="not snoozed_note">Reason: <field name="snoozed_note" readonly="1"/></span>
                    </div>

                    <div class="alert alert-secondary" role="alert"
                         invisible="not is_stale">
                        🕓 <strong>STALE DATA.</strong>
                        The last analysis batch for this warehouse failed, so these
                        numbers were left as-is instead of being refreshed or removed.
                        <field name="stale_reason" readonly="1" nolabel="1"/>
                    </div>

                     <div class="alert alert-warning" role="alert"
                          invisible="not needs_review">
                         🔎 <strong>NEEDS REVIEW.</strong>
                         <field name="needs_review_reason" readonly="1" nolabel="1"/>
                     </div>

                     <div class="alert alert-warning" role="alert"
                          invisible="not is_provisional">
                         ⚡ <strong>PROVISIONAL SUGGESTION.</strong> Stock went negative. Computed using emergency fallback. Run full analysis to replace with actual forecast.
                     </div>

                    <div class="alert alert-danger" role="alert"
                         invisible="qty_on_hand >= 0">
                        ⚠️ <strong>NEGATIVE STOCK!</strong>
                        On hand = <field name="qty_on_hand" readonly="1"/> units.
                        Reorder immediately and ensure receipts are booked correctly.
                    </div>

                    <div class="alert alert-warning" role="alert"
                         invisible="not is_dead_stock">
                        💀 <strong>DEAD STOCK.</strong>
                        No sales for <field name="months_since_last_sale" readonly="1"/> months.
                        Last sale: <field name="last_sale_date" readonly="1"/>.
                        Consider liquidating or returning to vendor.
                    </div>

                    <div class="alert alert-info" role="alert"
                         invisible="within_budget">
                        💰 This item exceeds the configured weekly budget cap.
                        It is ranked #<field name="budget_rank" readonly="1"/> in priority order.
                    </div>

                    <div class="alert alert-warning" role="alert"
                         invisible="not draft_po_ref">
                        📋 <strong>DRAFT PO PENDING:</strong>
                        <field name="draft_po_ref" readonly="1" nolabel="1" class="oe_inline"/>.
                        Reorder suggestions are held until it is confirmed or cancelled —
                        see the Calculation Breakdown below for details.
                    </div>

                    <div class="alert alert-success" role="alert"
                         invisible="not transfer_source_warehouse_id">
                        🔄 <strong>TRANSFER RECOMMENDED!</strong>
                        Warehouse <strong><field name="transfer_source_warehouse_id" readonly="1" options="{'no_open': True}"/></strong> has surplus stock of this item.
                        You can issue an internal transfer instead of an external PO.
                        Estimated transfer lead time:
                        <strong><field name="transfer_lead_time_days" readonly="1" nolabel="1" class="oe_inline"/> days</strong>.
                    </div>

                    <div style="background:#eafaf1; border:2px solid #27ae60;
                                border-radius:8px; padding:16px; margin-bottom:16px; display: block;"
                         invisible="not reorder_needed">
                        <div style="text-align:center;">
                            <p style="margin:0; font-size:13px; color:#555;">SUGGESTED REORDER QTY</p>
                            <div style="margin:4px 0; font-size:2.5rem; font-weight:700; color:#27ae60; display: flex; justify-content: center; align-items: baseline; gap: 8px;">
                                <field name="suggested_reorder_qty" readonly="1" nolabel="1"
                                       style="font-size:inherit; font-weight:inherit;"/>
                                <span style="font-size: 1.5rem; font-weight: 500; color: #27ae60;">units</span>
                            </div>
                            <div style="margin:0; color:#666; font-size:12px; display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 4px;">
                                <span>(Raw:</span>
                                <field name="raw_reorder_qty" readonly="1" nolabel="1" class="d-inline-block fw-bold"/>
                                <span>→ rounded up to MOQ of</span>
                                <field name="moq" readonly="1" nolabel="1" class="d-inline-block fw-bold"/>
                                <span>)</span>
                            </div>
                            <div style="margin:4px 0 0 0; color:#666; font-size:12px; display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 4px;">
                                <span>vs last run:</span>
                                <field name="prior_suggested_qty" readonly="1" nolabel="1" class="d-inline-block fw-bold"/>
                                <span>→</span>
                                <field name="delta_pct" readonly="1" nolabel="1" class="d-inline-block fw-bold"/>
                                <span>%</span>
                            </div>
                            <div style="margin:8px 0 0 0; font-size:1.1rem; color:#2c3e50; display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 12px;">
                                <div>
                                    <span>💰 Est. Cost (cost basis):</span>
                                    <field name="reorder_value" readonly="1" nolabel="1"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           class="fw-bold"/>
                                </div>
                                <div>
                                    <span>🛍️ Est. Purchase (vendor price):</span>
                                    <field name="estimated_purchase_value" readonly="1" nolabel="1"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           class="fw-bold"/>
                                </div>
                            </div>
                            <field name="currency_id" invisible="1"/>
                            <field name="reorder_needed" invisible="1"/>
                        </div>
                    </div>

                    <notebook>

                        <page string="📦 Stock &amp; Demand">
                            <group string="Current Stock Position">
                                <group>
                                    <field name="qty_on_hand" readonly="1"/>
                                    <field name="qty_incoming" readonly="1"/>
                                    <field name="qty_outgoing" readonly="1"/>
                                    <field name="qty_available" readonly="1"/>
                                    <field name="months_of_stock" readonly="1"/>
                                    <field name="months_of_stock_after_order" readonly="1"/>
                                    <field name="min_stock_level" readonly="1"/>
                                    <field name="max_stock_level" readonly="1"/>
                                    <field name="transfer_source_warehouse_id" readonly="1" invisible="not transfer_source_warehouse_id"/>
                                    <field name="transfer_suggested_qty" readonly="1" invisible="not transfer_source_warehouse_id"/>
                                </group>
                                <group>
                                    <field name="lead_time_months" readonly="1"/>
                                    <field name="safety_buffer_months" readonly="1"/>
                                    <field name="moq" readonly="1"/>
                                    <field name="product_cost" readonly="1"/>
                                    <field name="reorder_behavior" widget="radio" readonly="1"/>
                                </group>
                            </group>
                            <group string="Monthly Demand Analysis">
                                <group>
                                    <field name="analysis_months" readonly="1"/>
                                    <field name="date_from" readonly="1"/>
                                    <field name="date_to" readonly="1"/>
                                    <field name="total_qty_sold" readonly="1"/>
                                    <field name="avg_monthly_demand" readonly="1"/>
                                </group>
                                <group>
                                    <field name="is_dead_stock" readonly="1"/>
                                    <field name="last_sale_date" readonly="1"/>
                                    <field name="months_since_last_sale" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="📈 Trend &amp; Seasonal">
                            <group string="Demand Trend">
                                <group>
                                    <field name="demand_trend" readonly="1"/>
                                    <field name="sales_pattern" readonly="1"/>
                                    <field name="trend_pct" readonly="1" string="Change %"/>
                                    <field name="prev_period_qty_sold" readonly="1"/>
                                </group>
                            </group>
                            <group string="Seasonal Comparison (vs Last Year)">
                                <group>
                                    <field name="same_period_last_year_qty" readonly="1"/>
                                    <field name="seasonal_note" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="🚚 Vendor">
                            <group string="Vendor Information">
                                <group>
                                    <field name="vendor_id" readonly="1"/>
                                    <field name="vendor_stated_lead_days" readonly="1"/>
                                    <field name="vendor_actual_avg_days" readonly="1"/>
                                </group>
                                <group>
                                    <field name="vendor_performance_note" readonly="1"/>
                                </group>
                            </group>
                            <group string="Alternative Vendor" invisible="not alt_vendor_id">
                                <group>
                                    <field name="alt_vendor_id" readonly="1"/>
                                    <field name="alt_vendor_lead_days" readonly="1"/>
                                </group>
                                <group>
                                    <div class="text-muted">
                                        💡 This alternative vendor is faster than the primary vendor by at least the configured lead time margin.
                                    </div>
                                </group>
                            </group>
                        </page>

                        <page string="🧮 Calculation">
                            <group string="Demand Forecast (Average + Spike Rejection)">
                                <field name="excluded_outlier_months" readonly="1"/>
                                <field name="demand_forecast_note" readonly="1"/>
                                <field name="confidence" readonly="1" widget="progressbar"/>
                            </group>
                            <group string="Budget">
                                <field name="within_budget" readonly="1"/>
                                <field name="budget_rank" readonly="1"/>
                            </group>
                            <field name="notes" readonly="1" nolabel="1"
                                   style="font-family: monospace; background:#f5f5f5;
                                          padding:14px; border-radius:4px; white-space:pre-wrap;
                                          font-size:12px; line-height:1.6;"/>
                        </page>

                        <page string="🛍️ Draft Orders" invisible="not po_ids">
                            <field name="po_ids"/>
                        </page>

                        <page string="🧠 Snooze">
                            <group string="Snooze Settings">
                                <group>
                                    <field name="is_snoozed" readonly="1"/>
                                    <field name="snoozed_until"/>
                                    <field name="snoozed_note"/>
                                </group>
                            </group>
                            <div class="text-muted" style="padding:8px 0; font-size:12px;">
                                Set <strong>Snoozed Until</strong> to suppress this alert until that date.
                                The next cron run after the snooze expires will automatically re-evaluate.
                            </div>
                        </page>

                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- T-18: Kanban view grouped by urgency -->
    <record id="view_smart_reorder_suggestion_kanban" model="ir.ui.view">
        <field name="name">smart.reorder.suggestion.kanban</field>
        <field name="model">smart.reorder.suggestion</field>
        <field name="arch" type="xml">
            <kanban default_group_by="urgency" group_create="false" group_delete="false"
                    class="o_kanban_small_column" quick_create="false">
                <field name="product_id"/>
                <field name="urgency"/>
                <field name="urgency_rank"/>
                <field name="reorder_needed"/>
                <field name="is_snoozed"/>
                <field name="snoozed_until"/>
                <field name="qty_on_hand"/>
                <field name="avg_monthly_demand"/>
                <field name="suggested_reorder_qty"/>
                <field name="reorder_value"/>
                <field name="currency_id"/>
                <field name="abc_class"/>
                <field name="vendor_id"/>
                <field name="months_of_stock"/>
                <field name="default_code"/>
                <field name="sales_pattern"/>
                <progressbar field="urgency"
                             colors='{"critical": "danger", "urgent": "warning", "normal": "info", "dead": "muted", "ok": "success"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click
                            #{ record.urgency.raw_value == 'critical' ? 'border-danger' :
                               record.urgency.raw_value == 'urgent'   ? 'border-warning' :
                               record.urgency.raw_value == 'dead'     ? 'border-secondary' :
                               record.urgency.raw_value == 'ok'       ? 'border-success' : 'border-info' }"
                             style="border-left: 4px solid; border-radius: 4px; padding: 10px;">
                            <div class="oe_kanban_top" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                                <strong style="font-size:13px;">
                                    <t t-esc="record.product_id.value"/>
                                </strong>
                                <span t-if="record.is_snoozed.raw_value"
                                      class="badge bg-secondary" style="font-size:10px;">&#x23F0; Snoozed</span>
                            </div>
                            <div style="font-size:11px; color:#888; margin-bottom:6px;">
                                <t t-esc="record.default_code.value"/>
                            </div>
                            <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:8px;">
                                <span t-attf-class="badge
                                    #{ record.abc_class.raw_value == 'A' ? 'bg-danger' :
                                       record.abc_class.raw_value == 'B' ? 'bg-warning text-dark' : 'bg-secondary' }"
                                    style="font-size:10px;">
                                    <t t-esc="record.abc_class.value"/>
                                </span>
                                <span t-attf-class="badge
                                    #{ record.sales_pattern.raw_value == 'regular' ? 'bg-success' :
                                       record.sales_pattern.raw_value == 'sometimes' ? 'bg-info' :
                                       record.sales_pattern.raw_value == 'big_order_mixed' ? 'bg-warning text-dark' :
                                       record.sales_pattern.raw_value == 'one_time_big_order' ? 'bg-danger' : 'bg-secondary' }"
                                    style="font-size:10px;">
                                    <t t-esc="record.sales_pattern.value"/>
                                </span>
                            </div>
                            <div style="font-size:12px; line-height:1.8;">
                                <div><b>On Hand:</b> <t t-esc="record.qty_on_hand.value"/></div>
                                <div><b>Months Left:</b> <t t-esc="record.months_of_stock.value"/></div>
                                <div><b>Avg/Month:</b> <t t-esc="record.avg_monthly_demand.value"/></div>
                                <div t-if="record.reorder_needed.raw_value"
                                     style="margin-top:4px; font-weight:700; color:#27ae60;">
                                    &#x27A1; Reorder: <t t-esc="record.suggested_reorder_qty.value"/> units
                                </div>
                            </div>
                            <div t-if="record.vendor_id.value"
                                 style="margin-top:6px; font-size:11px; color:#555; border-top:1px solid #eee; padding-top:4px;">
                                &#x1F69A; <t t-esc="record.vendor_id.value"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_smart_reorder_suggestion_search" model="ir.ui.view">
        <field name="name">smart.reorder.suggestion.search</field>
        <field name="model">smart.reorder.suggestion</field>
        <field name="arch" type="xml">
            <search string="Search Reorder Suggestions">

                <field name="product_id"/>
                <field name="default_code" string="Part Number"/>
                <field name="warehouse_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="product_categ_id"/>
                <field name="vendor_id" string="Vendor"/>

                <filter name="reorder_needed"  string="🔁 Needs Reorder"
                        domain="[('reorder_needed','=',True), ('po_ids', '=', False)]"/>
                <filter name="critical"        string="🔴 Critical (Negative)"
                        domain="[('urgency','=','critical')]"/>
                <filter name="urgent"          string="🟠 Urgent"
                        domain="[('urgency','=','urgent')]"/>
                <filter name="dead_stock"      string="💀 Dead Stock"
                        domain="[('is_dead_stock','=',True)]"/>
                <filter name="within_budget"   string="💰 Within Budget"
                        domain="[('within_budget','=',True),('reorder_needed','=',True)]"/>
                <filter name="snoozed"         string="⏰ Snoozed"
                        domain="[('is_snoozed','=',True)]"/>
                <filter name="not_snoozed"     string="🟢 Active (Not Snoozed)"
                        domain="[('is_snoozed','=',False)]"/>
                <filter name="stale_data"      string="🕓 Stale Data"
                        domain="[('is_stale','=',True)]"/>
                <filter name="large_swing"     string="📊 Large Swing (&gt;50%)"
                        domain="['|', ('delta_pct','&gt;',50), ('delta_pct','&lt;',-50)]"/>
                <filter name="needs_review"    string="🔎 Needs Review"
                        domain="[('needs_review','=',True)]"/>

                <separator/>

                <filter name="fast_movers"     string="⚡ A — Fast Movers"
                        domain="[('abc_class','=','A')]"/>
                <filter name="medium_movers"   string="🔶 B — Medium Movers"
                        domain="[('abc_class','=','B')]"/>
                <filter name="slow_movers"     string="🐢 C — Slow Mover"
                        domain="[('abc_class','=','C')]"/>

                <separator/>

                <filter name="rising"          string="↑ Rising Demand"
                        domain="[('demand_trend','=','up')]"/>
                <filter name="falling"         string="↓ Falling Demand"
                        domain="[('demand_trend','=','down')]"/>

                <separator/>
                <filter name="pattern_regular"            string="Sells Regularly"
                        domain="[('sales_pattern','=','regular')]"/>
                <filter name="pattern_sometimes"          string="Sells Sometimes"
                        domain="[('sales_pattern','=','sometimes')]"/>
                <filter name="pattern_big_order_mixed"    string="Big Order Mixed In"
                        domain="[('sales_pattern','=','big_order_mixed')]"/>
                <filter name="pattern_one_time_big_order" string="One-Time Big Order Only"
                        domain="[('sales_pattern','=','one_time_big_order')]"/>
                <filter name="pattern_new"                string="New — No Sales History"
                        domain="[('sales_pattern','=','new')]"/>

                <separator/>
                <filter name="today"           string="Today's Analysis"
                        domain="[('analysis_date','=',context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="archived"        string="Archived (Out of Scope)"
                        domain="[('active','=',False)]"/>

                <group expand="0" string="Group By">
                    <filter name="gb_urgency"   string="Urgency"
                            context="{'group_by':'urgency'}"/>
                    <filter name="gb_company"   string="Company"
                            context="{'group_by':'company_id'}"/>
                    <filter name="gb_warehouse" string="Warehouse"
                            context="{'group_by':'warehouse_id'}"/>
                    <filter name="gb_abc"       string="ABC Class"
                            context="{'group_by':'abc_class'}"/>
                    <filter name="gb_trend"     string="Demand Trend"
                            context="{'group_by':'demand_trend'}"/>
                    <filter name="gb_sales_pattern" string="Sales Pattern"
                            context="{'group_by':'sales_pattern'}"/>
                    <filter name="gb_category"  string="Product Category"
                            context="{'group_by':'product_categ_id'}"/>
                    <filter name="gb_vendor"    string="Vendor"
                            context="{'group_by':'vendor_id'}"/>
                </group>

            </search>
        </field>
    </record>

