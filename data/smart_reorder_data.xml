<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
        ╔═══════════════════════════════════════════════════════════════════╗
        ║  SCHEDULED ACTION — Weekly Reorder Analysis                       ║
        ║                                                                   ║
        ║  Runs every Monday at 6:00 AM.                                   ║
        ║  Recalculates all suggestions for all companies/warehouses.       ║
        ║  Sends Odoo inbox notifications if critical items are found.      ║
        ║                                                                   ║
        ║  noupdate="1" means admins can change the schedule in the UI     ║
        ║  without it being reset on module update.                        ║
        ╚═══════════════════════════════════════════════════════════════════╝
        -->

        <record id="cron_smart_reorder_weekly" model="ir.cron">
            <field name="name">Smart Reorder: Weekly Analysis</field>
            <field name="model_id" ref="model_smart_reorder_suggestion"/>
            <field name="state">code</field>
            <field name="code">model.action_run_weekly_cron()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
